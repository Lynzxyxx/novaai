# ==== Auth ====
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=ganti-dengan-string-acak-panjang

# Login dengan Google (opsional, isi jika mau tombol "Login dengan Google")
# Buat di https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email yang otomatis jadi admin saat pertama kali login/daftar
ADMIN_EMAIL=admin@email-kamu.com

# ==== AI API (dari provider di screenshot kamu) ====
CHAT_API_BASE_URL=https://bandelbanget.xyz/v1
CHAT_API_KEY=isi-dengan-api-key-asli-kamu-di-sini
CHAT_MODEL=qwen-plus

# Batas pesan default per user per hari (bisa diubah lewat panel admin)
DEFAULT_DAILY_LIMIT=50

# ==== Firebase (database Firestore) ====
# 1) Buat project di https://console.firebase.google.com
# 2) Aktifkan Firestore Database
# 3) Project settings -> Service accounts -> Generate new private key (untuk 4 variabel di bawah)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Tempel private key dari file JSON service account, jaga tanda kutip di sekelilingnya
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Project settings -> General -> Your apps -> Web app (untuk fitur realtime di browser)
# Variabel ini AMAN dipublikasikan ke browser (memang didesain begitu oleh Firebase)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
